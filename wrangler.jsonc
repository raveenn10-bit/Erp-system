{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sanjeewa-distribution-erp",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-22",
  "upload_source_maps": true,
  "assets": {
    "directory": "web/out",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sanjeewa-erp-db",
      "database_id": "687383e8-33c2-4e73-a048-abd047289cd5",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "FRONTEND_ORIGIN": ""
  },
  "triggers": {
    "crons": [
      "0 2 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}

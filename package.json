{
  "name": "sanjeewa-distribution-erp",
  "private": true,
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w worker",
    "typecheck": "npm run typecheck -w worker && npm run typecheck -w web",
    "test": "npm test -w worker",
    "build": "npm run build -w web && npm run build -w worker",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:worker": "wrangler deploy",
    "cf:preview": "wrangler preview"
  }
}

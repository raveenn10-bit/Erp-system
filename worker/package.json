{
  "name": "@sanjeewa/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sanjeewa-erp-db --local --config ../wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply sanjeewa-erp-db --remote --config ../wrangler.jsonc",
    "preview": "wrangler preview --config ../wrangler.jsonc",
    "deploy": "wrangler deploy --config ../wrangler.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}

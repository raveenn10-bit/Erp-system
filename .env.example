# Optional: only set this when the frontend calls a separately hosted API Worker.
# The production configuration serves the frontend and API from one Worker origin.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Worker runtime configuration:
# - FRONTEND_ORIGIN is optional for same-origin production. Set it to an exact
#   additional frontend origin (or comma-separated origins) only when required.
# - Store SETUP_TOKEN as a Cloudflare secret; never commit its value.
